# localdev.env -- copied from localdev.env.example and filled in.
# Gitignored: real creds live here, not in the example or any tracked file.
# Used by scripts/local-connector-sidecar.py.

# ── LLM gateway (OpenAI-compatible endpoint) ─���─────────────────────────────
# Any server that speaks the OpenAI /v1/chat/completions API (streaming +
# tool_calls). Point OPENAI_BASE_URL at it; OPENAI_MODEL must be one it serves
# and your key is permitted to use. llm_provider stays openai (the connector's
# OpenAI provider accepts an arbitrary base_url).
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://<your-llm-gateway>/v1
OPENAI_MODEL=<a chat model the gateway serves>
OPENAI_API_KEY=<your-key-or-EMPTY-if-open>

# ── FortiSOAR box (SOAR data only: records + other connectors' ops) ─────────
# run_op / get_record / search_module_records reach this via probes._env ->
# pyfsr. Point at your 8.0 appliance. Self-signed → verify off.
FSR_BASE_URL=https://fortisoar.example.com:13000
FSR_USERNAME=labuser
FSR_PASSWORD=<your-password>
FSR_VERIFY_SSL=false

# ── sidecar ───────────────────────────────────���────────────────────���────────
# FSRPB_DEV=1 is set by the sidecar itself; repeat here if you run ops by hand.
# FSRPB_SIDECAR_PORT=4771
