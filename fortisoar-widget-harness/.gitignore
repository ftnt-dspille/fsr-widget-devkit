# Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Env / secrets
.env
.env.*
!.env.example

# Local-dev loop (scripts/local-connector-sidecar.py): real Frank + box creds
localdev.env
.venv-localdev/

# Live-matrix scenario rows: real record UUIDs, box-specific. Template ships
# as tests/live/scenarios.local.example.json. The glob covers the per-box files
# (scenarios.local.206.json, …) that MATRIX_ENV selects -- they carry real UUIDs
# and must never be tracked. The negation keeps the placeholder template.
tests/live/scenarios.local*.json
!tests/live/scenarios.local.example.json

# Live-matrix capture artifacts: full per-scenario timelines (input messages +
# every tool call's full input/output/error + raw frames). Box-specific,
# regenerated each run -- never committed.
tests/live/_artifacts/

# Recorded chat wire -- the evidence `npm run fixtures:audit` diffs the
# hand-written fixtures against (session.saveCapture). Durable on purpose: this
# used to live under test-results/, which Playwright wipes at the start of every
# run, so recordings that cost real box time were deleted by the next unrelated
# run. Never tracked: a raw capture carries the box host and real record uuids.
tests/live/captures/

# Last UI-selected SOAR target (basename of the chosen .env). Per-machine state.
.harness-active-env

# Build / runtime output
widget-packages/
dev/cache/
*.pid

# widgets-src is a local-only discovery root: in the monorepo it's a symlink to
# the sibling widgets repo; in a clone it's absent (the harness falls back to the
# committed examples/). Never track it -- a tracked symlink dangles on clone.
/widgets-src

# FortiSOAR app shell fetched by `npm run assets` (Fortinet platform JS -- each
# dev fetches it from their own licensed box; never committed).
/fsr_src

# OS
.DS_Store
._*
__MACOSX/
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Playwright
test-results/
playwright-report/

# Proprietary / non-redistributable: Fortinet's copyrighted dev-guide PDF.
# Obtain from your own licensed source; see docs/FortiSOAR-Widget-Development-Guide.md
docs/*.pdf

# Internal connector/widget design docs -- not shipped with the public harness
FSR_PLAYBOOK_BUILDER_*

# Introspection rig output (generated; baselines are committed separately)
/introspection-reports/

# Compiled from the .ts sources in tsconfig "include" (tsc emits .js next to
# each .ts). Build output, never tracked: `pnpm install` (prepare) and `pnpm build`
# regenerate them, and the Makefile targets that run harness code depend on
# `harness-build`. The hand-maintained .js siblings of the .ts files NOT in
# "include" (tests/e2e/*, tests/live/lib/*, playwright.config.js, ...) stay tracked.
/harness.module.js
/lib/chatSession.js
/lib/domCapture.js
/lib/harnessDrawer.js
/lib/harnessRender.js
/lib/harnessUtils.js
/lib/liveUiDriver.js
/lib/localUiDriver.js
/lib/soarBrowser.js
/lib/soarEnv.js
/lib/types.js
/lib/widgetTypecheck.js
/packager.js
/scripts/drive-live-widget.js
/scripts/extract-templates.js
/scripts/gen-soar-types.js
/scripts/introspect-gate.js
/scripts/introspect.js
/scripts/introspectSoar.js
/scripts/lint-angular.js
/scripts/lint-testids.js
/scripts/new-widget.js
/scripts/probe-bootstrap.js
/scripts/typecheck-widgets.js
/scripts/widget-verify-remote.js
/scripts/widget.js
/server.js
