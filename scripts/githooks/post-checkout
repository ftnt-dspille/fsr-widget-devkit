#!/usr/bin/env bash
# Shim: a repo-local core.hooksPath (scripts/githooks) replaces the global one,
# so chain to the global hook of the same name (customer/dash checks etc.).
# The global hooks chain back to a repo-local hooksPath; FSR_HOOK_SHIM stops
# that loop (when it is set, we ARE the global hook's "repo hook": no-op).
[ -n "${FSR_HOOK_SHIM:-}" ] && exit 0
name="$(basename "$0")"
global="$(git config --global core.hooksPath 2>/dev/null || true)"
global="${global/#\~/$HOME}"
export FSR_HOOK_SHIM=1
[ -n "$global" ] && [ -x "$global/$name" ] && exec "$global/$name" "$@"
exit 0
