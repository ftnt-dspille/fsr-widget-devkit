#!/usr/bin/env bash
# Effect-level guard for "merge to main only after live confirmation".
# git runs this for EVERY ref update (commit, merge incl. fast-forward, reset,
# pull, update-ref, branch -f). In the "prepared" state a non-zero exit aborts
# the whole transaction. Under Claude Code (CLAUDECODE set), any update of
# refs/heads/main is refused unless it is exactly the update `make promote`
# announced in $GIT_COMMON_DIR/fsr-promote-allow ("<old> <new>").
# A human shell (no CLAUDECODE) is never refused. Then chain to the global hook.
set -uo pipefail
state="${1:-}"
main_ref="refs/heads/${FSR_PROTECTED_BRANCH:-main}"
# Fast path (cost): git runs this hook ~17 times for ONE `git worktree add`, and
# a process start costs 0.15-0.3s on an endpoint-protected Mac, so the old
# body (cat, git rev-parse, git config per run) was ~0.38s a run and ~80% of a
# worktree add. Read stdin and decide in pure bash; start git only when an
# update of main actually has to be judged.
input=""
while IFS= read -r _l || [ -n "$_l" ]; do input+="$_l"$'\n'; done

case "$input" in *" $main_ref"$'\n'*) touches_main=1 ;; *) touches_main="" ;; esac
if [ "$state" = prepared ] && [ -n "${CLAUDECODE:-}" ] && [ -n "$touches_main" ]; then
  common="$(git rev-parse --git-common-dir 2>/dev/null)"
  allow="$(cat "$common/fsr-promote-allow" 2>/dev/null || true)"
  zero="0000000000000000000000000000000000000000"
  while read -r old new ref; do
    [ "$ref" = "$main_ref" ] || continue
    if [ "$old" = "$zero" ]; then
      # `git update-ref refs/heads/main <new>` without <old> reports a zero old
      # value; that is only a creation when main does not exist yet.
      cur="$(git rev-parse -q --verify "$main_ref" 2>/dev/null || true)"
      [ -z "$cur" ] && continue                # creating main (fresh clone/init)
      old="$cur"
    fi
    # git pack-refs (gc/maintenance runs it after a fetch) writes main into
    # packed-refs at its own value, then drops the loose ref. Neither moves main:
    # the drop is allowed only while the loose ref still exists AND packed-refs
    # already holds main at that value (a real delete of a packed main has no
    # loose file, and is refused).
    [ "$old" = "$new" ] && continue
    if [ "$new" = "$zero" ] && [ -f "$common/$main_ref" ] \
       && grep -qx "$old $main_ref" "$common/packed-refs" 2>/dev/null; then continue; fi
    if [ -n "$allow" ] && [ "$allow" = "$old $new" ]; then continue; fi
    echo "refused: agents update ${main_ref#refs/heads/} only through 'make promote REPO=<repo> BRANCH=<branch>', which requires a VERIFIED live-sanity stamp. Work on a branch." >&2
    exit 1
  done <<< "$input"
fi

# The global hooks dir, read from the global config files in bash (no git
# process); `git config` only when neither file names one.
global=""
if [ -n "${GIT_CONFIG_GLOBAL:-}" ]; then _cfs=("$GIT_CONFIG_GLOBAL")
else _cfs=("$HOME/.gitconfig" "${XDG_CONFIG_HOME:-$HOME/.config}/git/config"); fi
for _cf in "${_cfs[@]}"; do
  [ -f "$_cf" ] || continue
  _sec=""
  while IFS= read -r _l || [ -n "$_l" ]; do
    _l="${_l#"${_l%%[![:space:]]*}"}"
    case "$_l" in
      \[*) _sec="${_l,,}" ;;
      [Hh]ooks[Pp]ath*=*) [ "$_sec" = "[core]" ] && { global="${_l#*=}"; global="${global#"${global%%[![:space:]]*}"}"; } ;;
    esac
  done < "$_cf"
done
[ -n "$global" ] || [ -n "${GIT_CONFIG_GLOBAL:-}" ] || global="$(git config --global core.hooksPath 2>/dev/null || true)"
global="${global/#\~/$HOME}"
if [ -z "${FSR_HOOK_SHIM:-}" ] && [ -n "$global" ] && [ -x "$global/reference-transaction" ]; then
  export FSR_HOOK_SHIM=1
  printf '%s' "$input" | "$global/reference-transaction" "$@"; exit $?
fi
exit 0
